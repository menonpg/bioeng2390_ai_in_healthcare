    },
    {
      "type": "cs",
      "input": "runAutoML {\"input_spec\":{\"training_frame\":\"frame_0.750\",\"response_column\":\"seizure\",\"validation_frame\":\"frame_0.250\",\"blending_frame\":\"segments_df_frequency_features.hex\",\"leaderboard_frame\":\"frame_0.250\",\"ignored_columns\":[],\"sort_metric\":\"AUTO\"},\"build_control\":{\"distribution\":\"AUTO\",\"nfolds\":5,\"balance_classes\":false,\"stopping_criteria\":{\"seed\":-1,\"max_models\":0,\"max_runtime_secs\":0,\"max_runtime_secs_per_model\":360,\"stopping_rounds\":3,\"stopping_metric\":\"AUTO\",\"stopping_tolerance\":-1},\"keep_cross_validation_predictions\":true,\"keep_cross_validation_models\":true,\"keep_cross_validation_fold_assignment\":false,\"export_checkpoints_dir\":\"/content/models/\"},\"build_models\":{\"exclude_algos\":[\"DeepLearning\"],\"exploitation_ratio\":-1,\"monotone_constraints\":[]}}, 'exec'"
    },
